# ---------------------------------------------------------------------------
# opus-mt-translate-api — copy to .env and adjust.
# On Coolify, set these in the app's Environment Variables tab instead:
# a public repo must never carry a real .env.
# ---------------------------------------------------------------------------

# --- networking ------------------------------------------------------------
# Host port published on the VPS. Ignored by Coolify, which routes through
# its own proxy — see COOLIFY below.
PORT=8000

# Interface the port binds to. 127.0.0.1 keeps the service private (put your
# own reverse proxy in front); 0.0.0.0 exposes it on every interface.
BIND_HOST=127.0.0.1

# --- test page -------------------------------------------------------------
# false = API only, no HTML served at all.
# true  = built-in test console at /. Read the auth notes below before
#         enabling this on a public domain.
ENABLE_UI=false

# --- access control --------------------------------------------------------
# Empty = open endpoint. Set a value and every /translate call must send
# X-API-Key. The test page shows a key field when this is set.
API_KEY=

# Per-client-IP cap. 0 disables it.
RATE_LIMIT_RPM=20

# Translations in flight across the whole process. This is what actually
# protects a shared box: past this, requests get 503 instead of queueing
# and dragging the host down. 0 disables it.
MAX_CONCURRENT=4

# Set true when running behind a reverse proxy (Coolify, Traefik, nginx) so
# rate limiting reads X-Forwarded-For instead of the proxy's own IP.
# Leave false when exposed directly — otherwise the header is trivially spoofed.
TRUST_PROXY=false

# Comma-separated origins allowed to call the API from a browser.
# Empty = no CORS headers (the built-in page is same-origin, so it needs none).
CORS_ORIGINS=

# --- engine ----------------------------------------------------------------
# Languages compiled into the image (space-separated) and served at runtime
# (comma-separated). These two must agree.
TARGETS_BUILD=en fr es de
TARGETS=en,fr,es,de

# Seconds a language stays resident after its last use. 0 = never unload.
IDLE_TTL=300

# Concurrent requests / threads inside a single translation.
INTER_THREADS=2
INTRA_THREADS=1

# 1 is ~40% faster, 4 is marginally better.
BEAM_SIZE=2

# Request size ceiling. Lower it if the page is public.
MAX_CHARS=20000

# --- COOLIFY ---------------------------------------------------------------
# Uncomment in docker-compose.yml and set here. Coolify replaces the empty
# value with the generated domain and wires up its proxy and TLS.
# SERVICE_FQDN_OPUSMT_8000=
